{
  "name": "cline-ws-bridge-extension",
  "version": "1.0.0",
  "dependencies": {
    "ws": "^8.18.0",
    "@types/ws": "^8.5.12"
  },
  "contributes": {
    "configuration": {
      "title": "Cline Ws-Bridge",
      "properties": {
        "cline.wsBridge.port": {
          "type": "number",
          "default": 3456,
          "description": "WebSocket server port for browser automation."
        },
        "cline.wsBridge.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start Ws-Bridge server on activation."
        }
      }
    }
  }
}
